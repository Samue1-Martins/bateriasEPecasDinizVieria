rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      // Leitura pública somente para produtos ativos (ou inexistentes em getDoc)
      // Administradores autenticados podem ler todos os produtos (ativos e inativos)
      allow get: if resource == null || resource.data.active == true || isAdmin();
      allow list: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Bloqueia qualquer outra coleção por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
